{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedSideEffectImports": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["jest"]
  },
  "include": ["src/**/*.jsx", "src/**/*.d.ts"]
}
